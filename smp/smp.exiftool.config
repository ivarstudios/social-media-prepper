# ExifTool config: IVAR SMP's own XMP namespace (XMP-smp).
# Fingerprints tells SMP which fields it wrote, so text a person wrote or edited is never mistaken for its own.

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        smp => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::smp',
            },
        },
    },
);

%Image::ExifTool::UserDefined::smp = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-smp', 2 => 'Image' },
    NAMESPACE => { 'smp' => 'http://ns.ivar.studio/smp/1.0/' },
    WRITABLE  => 'string',
    Version       => { },
    Model         => { },
    BriefHash     => { },
    Written       => { },
    Fingerprints  => { },
    AddedKeywords => { List => 'Bag' },
    Flags         => { List => 'Bag' },
    CropFit       => { List => 'Bag' },
    Season        => { },
    TimeOfDay     => { },
    ShotType      => { },
    FocalPoint    => { },
    Language      => { },
);

1;
